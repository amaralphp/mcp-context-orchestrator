# Database URLs
MCP_DATASOURCE_POSTGRES_URL=jdbc:postgresql://localhost:5433/mcporch
MCP_DATASOURCE_MYSQL_URL=jdbc:mysql://localhost:3307/mcporch
MCP_DATASOURCE_MONGO_URI=mongodb://mcporch:mcporch_pass@localhost:27018/mcporch

# Database Credentials
MCP_DATASOURCE_USERNAME=mcporch
MCP_DATASOURCE_PASSWORD=mcporch_pass

# Kafka
MCP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MCP_KAFKA_AUDIT_TOPIC=audit-events

# Cache
MCP_CACHE_TTL_SECONDS=300

# Server
SERVER_PORT=8080
GRPC_SERVER_PORT=9090

# Active Profile (postgres | mysql | mongo)
SPRING_PROFILES_ACTIVE=postgres
